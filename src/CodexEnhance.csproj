<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings><AssemblyName>CodexEnhance</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest><Version>0.5.0</Version>
    <Product>Codex Enhance</Product><Description>Codex status monitor for Windows</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../collector/**/*.mjs" Link="collector/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../collector/prices.json" Link="collector/prices.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../assets/icons/*.svg" Link="assets/icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
