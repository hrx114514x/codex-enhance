<Window x:Class="CodexEnhance.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 状态浮窗" Width="386" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Grid x:Name="SurfaceRoot">
  <Border Margin="16" CornerRadius="20" Background="{DynamicResource Surface}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect x:Name="SurfaceShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.12" Color="#000000"/></Border.Effect></Border>
  <Border x:Name="Card" Margin="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="20">
   <Grid>
    <Grid x:Name="Pill" Margin="15,12" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="BeginDrag" MouseMove="DragMove" MouseLeftButtonUp="EndDrag" Cursor="Hand" ToolTip="点击展开，拖动调整位置" AutomationProperties.Name="展开状态浮窗">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Ellipse x:Name="PillDot" Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,10,0"/>
     <TextBlock x:Name="PillPhase" Grid.Column="1" Text="正在连接" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium"/>
     <TextBlock x:Name="PillMetric" Grid.Column="2" Margin="10,0" FontSize="12" Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular"/><ContentControl x:Name="PillChevron" Grid.Column="3"/>
    </Grid>
    <ScrollViewer x:Name="ExpandedScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
    <StackPanel x:Name="ExpandedContent" Margin="17,0">
     <Grid x:Name="Header" Margin="0,15,0,12" Background="Transparent" MouseLeftButtonDown="BeginDrag" MouseMove="DragMove" MouseLeftButtonUp="EndDrag">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <StackPanel Orientation="Horizontal"><TextBlock Text="当前对话" FontSize="10" Foreground="{DynamicResource Muted}"/><Border Margin="8,-2,0,-2" Padding="6,2" Background="{DynamicResource Panel}" CornerRadius="5"><TextBlock x:Name="FreshnessText" Text="连接中" FontSize="9" Foreground="{DynamicResource Faint}"/></Border></StackPanel>
       <Button x:Name="TaskPicker" Padding="0,6,0,0" HorizontalAlignment="Left" Click="OpenTaskPicker" ToolTip="选择要监视的任务" AutomationProperties.Name="选择监视任务"><TextBlock x:Name="TaskTitle" Text="等待 Codex" MaxWidth="232" TextTrimming="CharacterEllipsis" FontWeight="Medium" FontSize="12"/></Button>
      </StackPanel>
      <Button x:Name="MenuButton" Grid.Column="1" Width="27" Height="27" VerticalAlignment="Top" Click="ShowMenu" ToolTip="更多选项" AutomationProperties.Name="更多选项"/>
      <Button x:Name="CollapseButton" Grid.Column="2" Width="27" Height="27" VerticalAlignment="Top" Click="Collapse" ToolTip="收起浮窗" AutomationProperties.Name="收起浮窗"/>
     </Grid>
     <Button x:Name="ActivityButton" Padding="13,15" Background="{DynamicResource AccentSoft}" HorizontalContentAlignment="Stretch" Click="OpenMetrics" AutomationProperties.Name="查看当前阶段与性能详情">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="PhaseDot" Width="6" Height="6" Fill="{DynamicResource Accent}" Margin="0,0,8,0"/><TextBlock x:Name="PhaseText" Text="正在连接" FontSize="21" FontWeight="SemiBold"/></StackPanel>
        <TextBlock x:Name="ActivityDetailText" Margin="14,7,4,0" Text="等待状态更新" MaxWidth="190" HorizontalAlignment="Left" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
       </StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="PhaseTimeCaption" Text="阶段用时" HorizontalAlignment="Right" FontSize="9" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ElapsedText" Text="—" FontSize="20" Margin="0,2,0,0" FontWeight="Medium" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/></StackPanel>
      </Grid>
     </Button>
     <TextBlock Text="性能概览" Margin="1,16,0,8" FontSize="10" Foreground="{DynamicResource Muted}"/>
     <Button x:Name="MetricsButton" Background="{DynamicResource Panel}" Padding="12,10" HorizontalContentAlignment="Stretch" Click="OpenMetrics" ToolTip="查看上下文与缓存详情" AutomationProperties.Name="查看性能详情">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="上下文占用" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ContextText" Text="—" FontSize="23" FontWeight="Medium" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular"/><Grid Margin="0,7,0,0" Height="3" Width="136" HorizontalAlignment="Left"><Border Background="{DynamicResource Track}" CornerRadius="1.5"/><Border x:Name="ContextFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="1.5"/></Grid></StackPanel>
       <Border Grid.Column="1" Background="{DynamicResource Line}" Margin="0,2"/>
       <StackPanel Grid.Column="2" Margin="16,0,0,0"><TextBlock Text="缓存命中" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CacheText" Text="—" FontSize="23" FontWeight="Medium" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular"/><TextBlock Text="最近请求" FontSize="9" Foreground="{DynamicResource Faint}" Margin="0,5,0,0"/></StackPanel>
      </Grid>
     </Button>
     <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="FirstTokenButton" Background="{DynamicResource Panel}" Padding="12,10" HorizontalContentAlignment="Stretch" Click="OpenMetrics" AutomationProperties.Name="查看首字与性能详情"><StackPanel><TextBlock x:Name="FirstTokenLabel" Text="首字（日志）" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FirstTokenText" Text="—" FontSize="20" FontWeight="Medium" Margin="0,4,0,0" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="FirstTokenSource" Text="暂无记录" FontSize="9" Foreground="{DynamicResource Faint}" Margin="0,4,0,0"/></StackPanel></Button>
      <Button x:Name="OutputSpeedButton" Grid.Column="2" Background="{DynamicResource Panel}" Padding="12,10" HorizontalContentAlignment="Stretch" Click="OpenOutputSpeed" AutomationProperties.Name="查看输出速度"><StackPanel><TextBlock Text="输出速度" FontSize="10" Foreground="{DynamicResource Muted}"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock x:Name="OutputSpeedText" Text="—" FontSize="20" FontWeight="Medium" Typography.NumeralAlignment="Tabular"/><TextBlock Text="tok/s" FontSize="9" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="4,0,0,3"/></StackPanel><TextBlock x:Name="OutputSpeedSource" Text="等待记录" FontSize="9" Foreground="{DynamicResource Faint}" Margin="0,4,0,0"/></StackPanel></Button>
     </Grid>
     <Border Margin="0,13,0,10" Background="{DynamicResource Panel}" CornerRadius="11">
      <StackPanel>
       <Button x:Name="ConversationCostButton" Padding="12,11" Click="OpenQuota" HorizontalContentAlignment="Stretch" AutomationProperties.Name="查看此对话费用估算"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="此对话费用" FontSize="11" FontWeight="Medium"/><TextBlock x:Name="CostRefreshHint" Text="累计等效用量" FontSize="9" Foreground="{DynamicResource Faint}" Margin="0,5,0,0"/></StackPanel><TextBlock x:Name="ConversationCostSummary" Grid.Column="1" Text="正在统计" FontSize="20" FontWeight="Medium" VerticalAlignment="Center"/></Grid></Button>
       <Border Height="1" Background="{DynamicResource Line}" Margin="12,0"/>
       <Button x:Name="AccountQuotaButton" Padding="12,8" Click="OpenQuota" HorizontalContentAlignment="Stretch" AutomationProperties.Name="查看账号额度与等效金额"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl x:Name="QuotaIcon" Margin="0,0,7,0"/><TextBlock Grid.Column="1" Text="账号额度" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="QuotaSummary" Grid.Column="2" Text="正在读取" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource Muted}" Margin="8,0,4,0"/><ContentControl x:Name="QuotaChevron" Grid.Column="3"/></Grid></Button>
      </StackPanel>
     </Border>
     <Button x:Name="ToolsButton" Padding="3,9" Click="ToggleTools" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开工具调用"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl x:Name="ToolsIcon" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="工具记录" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="ToolsSummary" Grid.Column="2" Text="等待记录" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Margin="8,0,5,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"/><ContentControl x:Name="ToolsChevron" Grid.Column="3"/></Grid></Button>
     <StackPanel x:Name="ToolsDetails" Visibility="Collapsed" Margin="0,0,0,10"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="IssueList"/></ScrollViewer><Button Padding="0,6" HorizontalAlignment="Left" Click="OpenHistory" AutomationProperties.Name="查看全部调用"><StackPanel Orientation="Horizontal"><TextBlock Text="查看全部调用" Foreground="{DynamicResource Accent}" FontSize="11"/><ContentControl x:Name="HistoryArrow" Margin="7,0,0,0"/></StackPanel></Button><Button Padding="0,6" HorizontalContentAlignment="Stretch" Click="OpenCapabilities" AutomationProperties.Name="检查工具可用性"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="可用性检查" FontSize="11" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="CapabilitySummary" Grid.Column="1" Text="未验证" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid></Button></StackPanel>
     <Button x:Name="NetworkButton" Padding="3,9" HorizontalContentAlignment="Stretch" Click="OpenNetwork" AutomationProperties.Name="查看网络与响应监测"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="网络与响应" FontSize="11"/><TextBlock x:Name="NetworkSummary" Grid.Column="1" Text="等待采样" FontSize="10" Foreground="{DynamicResource Muted}"/></Grid><TextBlock x:Name="NetworkCaption" Margin="0,5,0,0" FontSize="9" Foreground="{DynamicResource Faint}" Text="点击查看连接与响应记录" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,7,0,0"/>
     <Grid Margin="0,10,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl x:Name="ModelIcon" Margin="0,0,6,0"/><Button x:Name="ModelButton" Grid.Column="1" Click="OpenModels" Padding="0,2" HorizontalContentAlignment="Left" AutomationProperties.Name="当前模型"><TextBlock x:Name="ModelText" Text="等待任务" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Button><Button x:Name="FollowButton" Grid.Column="2" Padding="3,2" Click="Follow" AutomationProperties.Name="跟随对话"><StackPanel Orientation="Horizontal"><ContentControl x:Name="FollowIcon" Margin="0,0,4,0"/><TextBlock x:Name="FollowText" Text="跟随对话" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></Button></Grid>
     <Border x:Name="ConnectionNotice" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="0,8"><TextBlock x:Name="ConnectionText" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Border>
    </StackPanel>
    </ScrollViewer>
   </Grid>
  </Border>
 </Grid>
</Window>
