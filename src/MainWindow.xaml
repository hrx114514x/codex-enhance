<Window x:Class="CodexEnhance.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 状态浮窗" Width="386" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Grid x:Name="SurfaceRoot">
  <Border Margin="16" CornerRadius="18" Background="{DynamicResource Surface}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect x:Name="SurfaceShadow" BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.18" Color="#000000"/></Border.Effect></Border>
  <Border x:Name="Card" Margin="16" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
   <Grid>
    <Grid x:Name="Pill" Margin="14,12" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="BeginDrag" MouseMove="DragMove" MouseLeftButtonUp="EndDrag" Cursor="Hand" ToolTip="点击展开，拖动调整位置" AutomationProperties.Name="展开状态浮窗">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,10,0"/>
     <TextBlock x:Name="PillPhase" Grid.Column="1" Text="正在连接" TextTrimming="CharacterEllipsis" FontSize="13"/>
     <TextBlock x:Name="PillMetric" Grid.Column="2" Margin="12,0" FontSize="13" Foreground="{DynamicResource Muted}"/>
     <ContentControl x:Name="PillChevron" Grid.Column="3"/>
    </Grid>
    <StackPanel x:Name="ExpandedContent">
     <Grid x:Name="Header" Margin="18,14,12,0" Background="Transparent" MouseLeftButtonDown="BeginDrag" MouseMove="DragMove" MouseLeftButtonUp="EndDrag">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <StackPanel Orientation="Horizontal"><TextBlock Text="当前任务" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FreshnessText" Text="连接中" FontSize="10" Foreground="{DynamicResource Faint}" Margin="9,1,0,0"/></StackPanel>
       <Button x:Name="TaskPicker" Padding="0,5,0,3" HorizontalAlignment="Left" Click="OpenTaskPicker" ToolTip="选择要监视的任务" AutomationProperties.Name="选择监视任务"><TextBlock x:Name="TaskTitle" Text="等待 Codex" MaxWidth="234" TextTrimming="CharacterEllipsis" FontWeight="Medium" FontSize="13"/></Button>
      </StackPanel>
      <Button x:Name="MenuButton" Grid.Column="1" Width="29" Height="29" Margin="1,0,2,0" VerticalAlignment="Top" Click="ShowMenu" ToolTip="更多选项" AutomationProperties.Name="更多选项"/>
      <Button x:Name="CollapseButton" Grid.Column="2" Width="29" Height="29" VerticalAlignment="Top" Click="Collapse" ToolTip="收起浮窗" AutomationProperties.Name="收起浮窗"/>
     </Grid>
     <Button x:Name="ActivityButton" Margin="15,10,15,6" Padding="3,8" HorizontalContentAlignment="Stretch" Click="OpenMetrics" AutomationProperties.Name="查看当前阶段与性能详情">
      <Grid Width="316"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="PhaseDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,9,0"/><TextBlock x:Name="PhaseText" Text="正在连接" FontSize="20" FontWeight="SemiBold"/></StackPanel>
        <TextBlock x:Name="ActivityDetailText" Margin="16,5,4,0" Text="等待状态更新" MaxWidth="220" HorizontalAlignment="Left" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"><TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform></TextBlock>
       </StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="PhaseTimeCaption" Text="当前阶段" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Faint}"/><TextBlock x:Name="ElapsedText" Text="—" FontSize="21" Margin="0,1,0,0" FontWeight="Medium" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right"/></StackPanel>
      </Grid>
     </Button>
     <Button x:Name="MetricsButton" Margin="15,4,15,6" Padding="3" HorizontalContentAlignment="Stretch" Click="OpenMetrics" ToolTip="查看上下文、缓存和首字指标" AutomationProperties.Name="查看性能详情">
      <Grid Width="314"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,13,0"><TextBlock Text="上下文" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ContextText" Text="—" FontSize="22" FontWeight="Medium" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/><Grid Margin="0,8,0,3" Height="3" Width="83" HorizontalAlignment="Left"><Border Background="{DynamicResource Track}" CornerRadius="1.5"/><Border x:Name="ContextFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="1.5"/></Grid></StackPanel>
       <Border Grid.Column="1" Background="{DynamicResource Line}" Margin="0,3"/>
       <StackPanel Grid.Column="2" Margin="15,0,0,0"><TextBlock Text="缓存命中" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CacheText" Text="—" FontSize="22" FontWeight="Medium" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/><TextBlock Text="最近请求" FontSize="10" Foreground="{DynamicResource Faint}" Margin="0,5,0,0"/></StackPanel>
       <Border Grid.Column="3" Background="{DynamicResource Line}" Margin="0,3"/>
       <StackPanel Grid.Column="4" Margin="15,0,0,0"><TextBlock x:Name="FirstTokenLabel" Text="首字（日志）" FontSize="10" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FirstTokenText" Text="—" FontSize="22" FontWeight="Medium" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="FirstTokenSource" Text="暂无记录" FontSize="10" Foreground="{DynamicResource Faint}" Margin="0,5,0,0"/></StackPanel>
      </Grid>
     </Button>
     <Button x:Name="OutputSpeedButton" Margin="15,0,15,12" Padding="3,5" HorizontalContentAlignment="Stretch" Click="OpenOutputSpeed" AutomationProperties.Name="查看输出速度">
      <Grid Width="314"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="输出速度" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="OutputSpeedSource" Text="等待记录" FontSize="10" Foreground="{DynamicResource Faint}" Margin="8,1,0,0"/></StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="OutputSpeedText" Text="—" FontSize="18" FontWeight="Medium" Typography.NumeralAlignment="Tabular"/><TextBlock Text="tok/s" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="5,0,0,3"/></StackPanel>
      </Grid>
     </Button>
     <Border Height="1" Background="{DynamicResource Line}" Margin="18,0"/>
     <Button Padding="18,11" Click="OpenQuota" HorizontalContentAlignment="Stretch" AutomationProperties.Name="查看账号额度与等效金额"><Grid Width="316"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl x:Name="QuotaIcon" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="账号额度" FontSize="13"/><TextBlock x:Name="QuotaSummary" Grid.Column="2" Text="正在读取" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,9,0"/><ContentControl x:Name="QuotaChevron" Grid.Column="3"/></Grid></Button>
     <Button x:Name="ToolsButton" Padding="18,11" Click="ToggleTools" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开工具调用"><Grid Width="316"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl x:Name="ToolsIcon" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="工具记录" FontSize="13"/><TextBlock x:Name="ToolsSummary" Grid.Column="2" Text="等待记录" HorizontalAlignment="Right" FontSize="11" Margin="8,0,9,0" TextTrimming="CharacterEllipsis"/><ContentControl x:Name="ToolsChevron" Grid.Column="3"/></Grid></Button>
     <StackPanel x:Name="ToolsDetails" Visibility="Collapsed" Margin="18,0,18,14"><ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="IssueList"/></ScrollViewer><Border Height="1" Background="{DynamicResource Line}" Margin="0,9,0,8"/><Button Padding="0,4" HorizontalAlignment="Left" Click="OpenHistory" AutomationProperties.Name="查看全部调用"><StackPanel Orientation="Horizontal"><TextBlock Text="查看全部调用" Foreground="{DynamicResource Accent}" FontSize="12"/><ContentControl x:Name="HistoryArrow" Margin="7,0,0,0"/></StackPanel></Button><Button Padding="0,8,0,2" HorizontalContentAlignment="Stretch" Click="OpenCapabilities" AutomationProperties.Name="检查工具可用性"><Grid Width="316"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="可用性检查" FontSize="12" Foreground="{DynamicResource Accent}"/><TextBlock x:Name="CapabilitySummary" Grid.Column="1" Text="未验证" FontSize="11" Foreground="{DynamicResource Muted}"/></Grid></Button></StackPanel>
     <Border Height="1" Background="{DynamicResource Line}" Margin="18,0"/>
     <Grid Margin="18,11,15,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentControl x:Name="ModelIcon" Margin="0,0,7,0"/><Button x:Name="ModelButton" Grid.Column="1" Click="OpenModels" Padding="0,2" HorizontalContentAlignment="Left" AutomationProperties.Name="当前模型"><TextBlock x:Name="ModelText" Text="等待任务" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Button><Button x:Name="FollowButton" Grid.Column="2" Padding="4,2" Click="Follow" AutomationProperties.Name="跟随对话"><StackPanel Orientation="Horizontal"><ContentControl x:Name="FollowIcon" Margin="0,0,5,0"/><TextBlock x:Name="FollowText" Text="跟随对话" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></Button></Grid>
     <Border x:Name="ConnectionNotice" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="18,9"><TextBlock x:Name="ConnectionText" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Border>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
